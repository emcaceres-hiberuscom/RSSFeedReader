@page "/"
@inject SubscriptionApiClient SubscriptionApiClient

<PageTitle>Subscriptions</PageTitle>

<h1>Subscriptions</h1>

@if (IsLoading)
{
    <p>Loading...</p>
}
else
{
    <AddSubscriptionForm OnSubscriptionAdded="OnSubscriptionAddedAsync" />

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">@ErrorMessage</div>
    }

    <div class="mt-3">
        <SubscriptionList Subscriptions="SubscriptionItems" />
    </div>
}

@code {
    private List<SubscriptionDto> SubscriptionItems { get; set; } = [];
    private bool IsLoading { get; set; } = true;
    private string ErrorMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubscriptionsAsync();
        IsLoading = false;
    }

    private async Task OnSubscriptionAddedAsync(string url)
    {
        try
        {
            ErrorMessage = string.Empty;
            var created = await SubscriptionApiClient.AddSubscriptionAsync(url);
            SubscriptionItems = [.. SubscriptionItems, created];
            SubscriptionItems = SubscriptionItems.OrderBy(s => s.AddedAt).ToList();
        }
        catch
        {
            ErrorMessage = "Unable to add subscription. Please try again.";
        }
    }

    private async Task LoadSubscriptionsAsync()
    {
        try
        {
            ErrorMessage = string.Empty;
            SubscriptionItems = (await SubscriptionApiClient.GetSubscriptionsAsync()).ToList();
        }
        catch
        {
            ErrorMessage = "Unable to load subscriptions. Please refresh the page.";
            SubscriptionItems = [];
        }
    }
}
